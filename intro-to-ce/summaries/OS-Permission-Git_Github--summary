.net{display:flex;align-items:stretch;justify-content:center;gap:10px;flex-wrap:wrap}
.box{padding:12px 14px;border-radius:12px;color:#fff;font-weight:700;text-align:center;font-size:14px;min-width:150px;flex:1;max-width:300px}
.box small{display:block;font-weight:400;font-size:12px}
.mid{display:flex;flex-direction:column;justify-content:center;gap:10px;text-align:center;font-size:13px;min-width:130px}
.mid .push{color:var(--green);font-weight:700}.mid .pull{color:var(--blue);font-weight:700}
footer{text-align:center;color:var(--muted);padding:24px;font-size:14px}
