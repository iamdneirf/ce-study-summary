<footer>ขอให้สอบผ่านนะ ✌️</footer>
<script>
(function(){
  var boxes=document.querySelectorAll('#calc input');
  function upd(){
    var sym='',num='';
    for(var g=0;g<3;g++){
      var sum=0;
      for(var i=0;i<3;i++){
        var b=boxes[g*3+i];
        sym+=b.checked?'rwx'[i]:'-';
        if(b.checked)sum+=parseInt(b.getAttribute('data-v'),10);
      }
      num+=sum;
    }
    document.getElementById('sym').textContent=sym;
    document.getElementById('num').textContent=num;
  }
  for(var k=0;k<boxes.length;k++)boxes[k].addEventListener('change',upd);
  upd();
})();
</script>
